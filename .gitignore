# Device credentials
firmware/OpenPrintTagDryer/secrets.h

# Desktop test build artefacts
tests/build/
tests/opt_tests
tests/logic_tests
tests/dump_tag
tests/opt_tests_asan

# Arduino IDE. Scoped to the sketch rather than a bare *.bin, which would also
# swallow tests/fixtures/*.bin -- the specification's tag images, which the test
# harness needs and which are meant to be checked in.
firmware/**/build/
firmware/**/*.bin
*.elf
*.map

# KiCad
*-backups/
*.kicad_prl
fp-info-cache
*.bak
*.kicad_sch-bak
*.kicad_pcb-bak

# SKiDL byproducts. The netlist, BOM and netlist.md are checked in; the log,
# the ERC report and the scratch symbol library are regenerated by the script.
hardware/carrier/*.log
hardware/carrier/*.erc
hardware/carrier/*_sklib.py

# Mechanical: the STLs and previews are generated but checked in, so that a
# print does not require a Python environment. Only the venv is ignored.
mechanical/.venv/

# Python
__pycache__/
*.pyc

# Editors / OS
.DS_Store
*.swp
.vscode/
